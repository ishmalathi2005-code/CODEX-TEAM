{
  "name": "codex-ai-interview-simulator",
  "version": "1.0.0",
  "description": "CODEX AI Interview Simulator — Fullstack Application (Express Backend + React Frontend + Supabase DB)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:backend": "nodemon server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:frontend\"",
    "migrate": "node migrate.js",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "codex",
    "ai",
    "interview",
    "simulator",
    "backend",
    "frontend",
    "supabase"
  ],
  "author": "CODEX Team",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@prisma/client": "^5.16.0",
    "@supabase/server": "^1.4.1",
    "@supabase/supabase-js": "^2.44.4",
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.13",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.16.0"
  }
}
