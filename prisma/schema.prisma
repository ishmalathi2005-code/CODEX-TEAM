// This is your Prisma schema file for CODEX AI Interview Simulator
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  user
  admin
}

enum InterviewType {
  technical
  behavioral
  mixed
  coding
  system_design
}

enum Difficulty {
  easy
  medium
  hard
}

enum InterviewStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum QuestionType {
  technical
  behavioral
  coding
  system_design
  mcq
}

enum SkillLevel {
  none
  beginner
  intermediate
  advanced
  expert
}

enum Priority {
  low
  medium
  high
  critical
}

enum EvalStatus {
  pending
  processing
  completed
  failed
}

enum Grade {
  A_PLUS
  A
  B_PLUS
  B
  C_PLUS
  C
  D
  F
}

enum Badge {
  beginner
  intermediate
  advanced
  expert
  master
}

enum RecommendedBy {
  ai
  manual
  rule_based
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                   String    @id @default(cuid())
  name                 String    @db.VarChar(100)
  email                String    @unique @db.VarChar(255)
  password             String
  role                 Role      @default(user)
  isActive             Boolean   @default(true)
  isEmailVerified      Boolean   @default(false)
  refreshToken         String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  lastLogin            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  profile              Profile?
  interviews           Interview[]
  answers              Answer[]
  questions            Question[]        @relation("QuestionCreator")
  evaluations          Evaluation[]
  results              Result[]
  skillRecommendations SkillRecommendation[]

  @@map("users")
}

model Profile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  bio                   String?  @db.VarChar(500)
  avatar                String?
  phone                 String?
  location              String?
  linkedIn              String?
  github                String?
  skills                Json     @default("[]")   // Array of { name, level }
  experienceYears       Int      @default(0)
  targetRole            String?
  targetCompanies       String[] @default([])
  preferredInterviewType InterviewType @default(mixed)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Interview {
  id               String          @id @default(cuid())
  candidateId      String
  title            String
  type             InterviewType
  difficulty       Difficulty      @default(medium)
  status           InterviewStatus @default(scheduled)
  domain           String?
  totalQuestions   Int             @default(0)
  durationMinutes  Int             @default(30)
  startedAt        DateTime?
  endedAt          DateTime?
  notes            String?         @db.VarChar(1000)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relations
  candidate        User            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  questions        InterviewQuestion[]
  answers          Answer[]
  evaluation       Evaluation?
  result           Result?
  skillRecommendations SkillRecommendation[]

  @@map("interviews")
}

model Question {
  id              String       @id @default(cuid())
  text            String
  type            QuestionType
  category        String
  difficulty      Difficulty   @default(medium)
  tags            String[]     @default([])
  expectedAnswer  String?
  scoringRubric   String?
  mcqOptions      Json?        // Array of { text, isCorrect }
  codeLanguage    String?
  starterCode     String?
  hints           String[]     @default([])
  createdById     String?
  isActive        Boolean      @default(true)
  usageCount      Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  createdBy       User?        @relation("QuestionCreator", fields: [createdById], references: [id])
  interviews      InterviewQuestion[]
  answers         Answer[]
  evalAnswers     EvaluationAnswer[]

  @@index([type, category, difficulty])
  @@map("questions")
}

// Junction table: Interview ↔ Question (many-to-many)
model InterviewQuestion {
  interviewId String
  questionId  String
  order       Int      @default(0)

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question    Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([interviewId, questionId])
  @@map("interview_questions")
}

model Answer {
  id                String    @id @default(cuid())
  interviewId       String
  questionId        String
  candidateId       String
  answerText        String?
  codeAnswer        String?
  selectedOption    Int?
  timeTakenSeconds  Int       @default(0)
  isSkipped         Boolean   @default(false)
  audioUrl          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  interview         Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question          Question  @relation(fields: [questionId], references: [id])
  candidate         User      @relation(fields: [candidateId], references: [id])
  evalAnswer        EvaluationAnswer?

  @@unique([interviewId, questionId])
  @@map("answers")
}

model Evaluation {
  id                   String     @id @default(cuid())
  interviewId          String     @unique
  candidateId          String
  status               EvalStatus @default(pending)
  overallFeedback      String?
  technicalScore       Float?
  communicationScore   Float?
  problemSolvingScore  Float?
  evaluatedAt          DateTime?
  aiProvider           String?    @default("openai")
  tokensUsed           Int?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  // Relations
  interview            Interview  @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  candidate            User       @relation(fields: [candidateId], references: [id])
  answerEvaluations    EvaluationAnswer[]
  result               Result?

  @@map("evaluations")
}

model EvaluationAnswer {
  id           String     @id @default(cuid())
  evaluationId String
  answerId     String     @unique
  questionId   String
  score        Float?
  feedback     String?
  strengths    String[]   @default([])
  improvements String[]   @default([])
  aiModel      String?
  createdAt    DateTime   @default(now())

  // Relations
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  answer       Answer     @relation(fields: [answerId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id])

  @@map("evaluation_answers")
}

model Result {
  id                   String    @id @default(cuid())
  interviewId          String    @unique
  candidateId          String
  evaluationId         String?   @unique
  totalScore           Float?
  percentile           Float?
  grade                Grade?
  passed               Boolean?
  questionsAttempted   Int?
  questionsCorrect     Int?
  totalTimeTakenSeconds Int?
  categoryBreakdown    Json?     // Array of { category, score, maxScore }
  badge                Badge?
  isPublic             Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  interview            Interview  @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  candidate            User       @relation(fields: [candidateId], references: [id])
  evaluation           Evaluation? @relation(fields: [evaluationId], references: [id])

  @@map("results")
}

model SkillRecommendation {
  id                String        @id @default(cuid())
  candidateId       String
  basedOnInterviewId String?
  recommendations   Json          // Array of { skill, currentLevel, targetLevel, priority, reason, resources }
  generatedBy       RecommendedBy @default(ai)
  isStale           Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  candidate         User          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  basedOnInterview  Interview?    @relation(fields: [basedOnInterviewId], references: [id])

  @@map("skill_recommendations")
}
